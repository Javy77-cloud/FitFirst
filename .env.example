DATABASE_URL=postgres://fitfirst:fitfirst_dev@127.0.0.1:5432/fitfirst
TENANT_ID=11111111-1111-4111-8111-111111111111
UPLOAD_DIR=./uploads
# Production documents use Vercel Blob store fitfirst-docs (BLOB_STORE_ID / BLOB_READ_WRITE_TOKEN).
PORT=43147
# Optional. Hashed at seed time for the local Admin user only. Never commit a hash or a real password.
# DEV_ADMIN_PASSWORD=
# MFA demo bypass for seeded Javy/Maya (already enrolled). Set 0 to prompt for TOTP after password.
FF_MFA_DEMO_BYPASS=1
# Optional. 32-byte AES-256-GCM key (64 hex chars or base64) for carrier portal username/password.
# Falls back to PII_ENCRYPTION_KEY, then a local Mac demo key. Never commit a production key.
# CARRIER_SECRETS_KEY=
# Optional. Google Places address suggestions. Desk loads without it — type the address by hand.
# Property Maps / Zillow / FEMA links stay free public search URLs and do not use this key.
# Social / GBP OAuth uses agency-pasted app credentials in Settings → Social — do not put Meta keys here.
# Free BYO OAuth (Gmail, Calendar, Meet, Outlook Calendar, Yahoo, DocuSign sandbox).
# Agency Admin pastes the same values in Settings, or set env as a local fallback.
# Never commit live secrets. Redirect URI: {origin}/api/integrations/oauth/callback
# (social stays {origin}/api/social/oauth/callback).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT=common
# YAHOO_OAUTH_CLIENT_ID=
# YAHOO_OAUTH_CLIENT_SECRET=
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_SECRET_KEY=
# DOCUSIGN_AUTH_BASE=https://account-d.docusign.com
# GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Mapbox Geocoding typeahead for every address field. Server-side preferred so the token
# is not required in the browser bundle. NEXT_PUBLIC_MAPBOX_TOKEN is also accepted.
# Never commit a live token. Production should set this in Vercel Production env.
# MAPBOX_ACCESS_TOKEN=
# MAPBOX_TOKEN=
# NEXT_PUBLIC_MAPBOX_TOKEN=
# FedEx Address Validation — verification only, not typeahead. Agency BYO — never commit live secrets.
# Prefer Settings → Developer Hub → API vault (site developers only). Env is a local fallback
# when the vault row is empty. Verify address still shows; click says verification isn’t set up without these.
# FEDEX_API_KEY=
# FEDEX_API_SECRET=
# FEDEX_ACCOUNT_NUMBER=
# FEDEX_API_ENV=sandbox
# Comma-separated emails that may unlock the API vault. Admin is not enough.
# FF_SITE_DEVELOPER_EMAILS=javy@fitfirst.local
# 32-byte AES-256-GCM key as 64 hex chars. Local Mac demo key — not production.
# Changing this key makes existing ciphertext unreadable; re-run db:seed.
PII_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Optional. Seeded Admin bearer for /api/v1 (hashed in api_tokens). Local desk only.
# DEMO_API_TOKEN=ff_demo_admin
# Optional. Seeded org API key for Standalone function REST (/api/dev/functions/*/execute).
# DEVHUB_DEMO_API_KEY=ffk_devhub_demo
# Optional. Property enrichment on address confirm. Agency BYO — desk runs without them (working stubs).
# Never scrape Zillow or county HTML. Never use a Zestimate as Coverage A.
# ATTOM_API_KEY=
# ESTATED_API_KEY=
# Master sheet → Fill from property records via getparceldata.com (geocode → /v1/parcels/point).
# Agency BYO monthly API (Starter $29/mo at getparceldata.com/api) — not the $49/$199 one-time extracts.
# When this key (or vault row provider=getparceldata) is present, Fill calls live HTTP. No stub path.
# Without a key, GetParcel is skipped and free sources still run (county PA / FloodZoneMap / FEMA).
# GETPARCELDATA_API_KEY=
# Master sheet → Fill permit history via permit-stack.com /v1/property/history (X-API-Key).
# Agency BYO. Maps confident roofing / HVAC / water-heater years as CHECK. Ambiguous permits skipped.
# Free tier = last 30 days; paid = full history. Same code path. Fail-soft if missing or the API errors.
# Vault row provider=permitstack is an alternate store (same AES key as FedEx / GetParcelData).
# PERMITSTACK_API_KEY=
# Master sheet → Fill from source (wind mit / 4-point / dec). Agency BYO Google AI Studio key.
# Without this key Fill flashes not configured and writes nothing. Env-first for MVP;
# developer vault provider=gemini is optional later (same pattern as getparceldata).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Learning pool consent at purchase. Default off / dormant. Do not enable until LEGAL signs off.
# LEARNING_POOL_CONSENT_LIVE=0
# HealthSherpa Medicare Partner API (BYO). Vault row provider=healthsherpa_medicare is preferred.
# Staging: https://api.medicare-staging.healthsherpa.com/v1
# Production: https://api.medicare.healthsherpa.com/v1
# HEALTHSHERPA_MEDICARE_API_KEY=
# HEALTHSHERPA_MEDICARE_ENV=sandbox
# HEALTHSHERPA_AGENT_EMAIL=
# Marketplace / ACA QuoteConnect — partner onboarding required. Scaffold only until this key exists.
# HEALTHSHERPA_ACA_API_KEY=
# HEALTHSHERPA_ACA_ENV=sandbox
# Secret HealthSherpa sends as X-API-Key to POST /api/integrations/healthsherpa/webhook
# (or use a Developer Hub org API key). Manual enrollments may not fire.
# HEALTHSHERPA_WEBHOOK_API_KEY=
