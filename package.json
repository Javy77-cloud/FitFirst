{
  "name": "fitfirst",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "GEMINI_MODEL=gemini-3.6-flash next dev --port 43147 --hostname 0.0.0.0",
    "build": "next build",
    "start": "GEMINI_MODEL=gemini-3.6-flash next start --port 43147 --hostname 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:wipe-crm": "tsx --env-file=.env scripts/wipe-crm.ts",
    "db:import-zoho": "tsx --env-file=.env scripts/import-zoho.ts",
    "db:assign-owner": "tsx --env-file=.env scripts/assign-owner.ts",
    "fixtures:pdf": "tsx scripts/generate-pdfs.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@napi-rs/canvas": "^0.1.80",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "heic-convert": "^2.1.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "postgres": "^3.4.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
